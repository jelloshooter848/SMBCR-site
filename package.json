{
  "name": "smbcr-site",
  "version": "1.0.0",
  "private": true,
  "description": "Official website for Super Mario Bros. Crossover: REMIX, a free fan remake playable in the browser.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node tools/check-links.mjs dist",
    "check:a11y": "node tools/check-a11y.mjs dist",
    "check": "npm run check:html && npm run check:links && npm run check:a11y",
    "capture": "node tools/capture/capture.mjs",
    "screenshots": "node tools/screenshots.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "astro": "7.3.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "html-validate": "11.16.2",
    "playwright": "1.56.1"
  },
  "engines": {
    "node": ">=22"
  }
}
