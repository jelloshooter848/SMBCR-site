---
import Base from '../layouts/Base.astro';
import PixelArt from '../components/PixelArt.astro';
import LatestRelease from '../components/LatestRelease.astro';
import HomeChapter1 from '../campaign/HomeChapter1.astro';
import { GAME, SHOW_CAMPAIGN } from '../config';
import { url, media } from '../lib';

// Version 0.5.0 is Classic mode: a true remake of Super Mario Bros. Crossover 3.1.21. The story
// campaign's home page waits in src/campaign for the 1.0 release.
const features = [
  {
    icon: 'star',
    title: 'The original ten heroes',
    text: 'Mario, Luigi, Link, Samus, Simon, Mega Man, Bass, Bill, Ryu and Sophia III, plus Random, each with the moves of their own game.',
  },
  {
    icon: 'heart',
    title: 'Looks that play differently',
    text: 'Each hero’s alternate looks, as in the original, and many of them play their own way.',
  },
  {
    icon: 'qblock',
    title: 'Three map sets',
    text: 'Super Mario Bros., The Lost Levels played straight through from 1-1 to D-4, and the Special maps.',
  },
  {
    icon: 'coin',
    title: 'Easy, Normal or Hard',
    text: 'Every map set at three difficulties, with the original’s options: More settings, Weapons, Cheats, Survival and per-hero music.',
  },
  {
    icon: 'star',
    title: 'Plays everywhere',
    text: 'Keyboard, gamepad or touch, with remappable controls and accessibility options. Free, in your browser.',
  },
] as const;

const roadmap = [
  { version: '0.5.0', title: 'Classic mode', text: 'The first full release: the remake of the original, with our own art and music.' },
  { version: '0.5.x', title: 'More looks', text: 'About 60 more of the original’s cosmetic looks.' },
  { version: '0.6 – 0.9', title: 'New heroes', text: 'More heroes join the roster.' },
  { version: '1.0', title: 'Chapter 1', text: 'The story campaign.' },
];
---

{
  SHOW_CAMPAIGN ? (
    <HomeChapter1 />
  ) : (
    <Base>
      <div class="sky home-hero">
        <PixelArt name="cloud" scale={5} class="cloud c1" />
        <PixelArt name="cloud" scale={3} class="cloud c2" />
        <div class="wrap home-hero__inner">
          <h1 class="logo">
            <img
              src={media('logo-remix.png')}
              alt="Super Mario Bros. Crossover: REMIX"
              width="470"
              height="180"
              fetchpriority="high"
            />
          </h1>
          <p class="home-hero__pitch">
            A true remake of <cite>Super Mario Bros. Crossover</cite>: play Super Mario Bros. as the heroes of other NES
            classics, right in your browser. Free, no install, no account.
          </p>
          <div class="btn-row">
            <a class="btn btn--red btn--play" href={GAME.playUrl}>
              ▶ Play
            </a>
            <a class="btn" href={url('how-to-play/')}>
              How to play
            </a>
          </div>
        </div>
        <div class="ground" aria-hidden="true" />
      </div>

      <div class="wrap">
        <p class="notice status">
          <strong>Version {GAME.launchVersion}, the first full release, is on its way.</strong> Until then, test builds
          come out as the work lands, so things may change between visits. Found something odd?{' '}
          <a href={url('community/#bugs')}>Report it</a>.
        </p>

        <section aria-labelledby="pitch-title">
          <h2 id="pitch-title">A fan remake of a fan classic</h2>
          <p class="lede">
            In 2010, Jay Pavlina's Flash game <cite>Super Mario Bros. Crossover</cite> let you run through Super Mario
            Bros. as Mega Man, Link, Samus and friends. Flash is gone, so <strong>REMIX</strong> rebuilds it from scratch
            for modern browsers and phones: the same game, with very little changed, drawn and scored anew with original
            NES-style pixel art and chiptune music. (Exploding Rabbit logo © Jay Pavlina / Exploding Rabbit, used as a tribute in Classic mode; will be replaced on request.)
          </p>
        </section>

        <section aria-labelledby="features-title">
          <h2 id="features-title">What's in {GAME.launchVersion}</h2>
          <ul class="grid features">
            {features.map((f) => (
              <li class="panel feature">
                <PixelArt name={f.icon} scale={3} />
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </li>
            ))}
          </ul>
          <p>
            <a href={url('heroes/')}>Meet the heroes</a>, explore the <a href={url('modes/')}>maps and modes</a>, or{' '}
            <a href={url('how-to-play/')}>see how to play</a>.
          </p>
        </section>

        <section aria-labelledby="roadmap-title">
          <h2 id="roadmap-title">What's next</h2>
          <ol class="roadmap">
            {roadmap.map((r) => (
              <li class="panel">
                <p class="tag">{r.version}</p>
                <h3>{r.title}</h3>
                <p>{r.text}</p>
              </li>
            ))}
          </ol>
          <p>
            Every major and minor release so far is <a href={url('versions/')}>playable on this site</a>.
          </p>
        </section>

        <section class="home-release">
          <LatestRelease />
        </section>

        <section aria-labelledby="join-title" class="panel join">
          <h2 id="join-title">Join in</h2>
          <p>
            Talk about the game and ask questions on the forum. Found a bug? Report it with the bug form and it goes
            straight to the developer.
          </p>
          <div class="btn-row">
            <a class="btn btn--blue" href={url('community/')}>
              Community
            </a>
            <a class="btn btn--blue" href={url('community/#bugs')}>
              Report a bug
            </a>
          </div>
        </section>
      </div>
    </Base>
  )
}

<style>
  .home-hero .c1 {
    top: 24px;
    left: 4%;
  }
  .home-hero .c2 {
    top: 120px;
    right: 12%;
  }
  .home-hero__inner {
    position: relative;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .logo {
    margin: 0 0 1rem;
    text-shadow: none;
  }
  .logo img {
    width: 100%;
    max-width: 470px;
  }
  .home-hero__pitch {
    font-size: 1.25rem;
    font-weight: 700;
    max-width: 36rem;
  }
  .status {
    margin-top: 2.5rem;
  }
  .features,
  .roadmap {
    list-style: none;
    padding: 0;
  }
  .feature h3,
  .roadmap h3 {
    margin: 0.75rem 0 0.5rem;
    color: var(--gold);
  }
  .roadmap {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }
  .roadmap p:last-child {
    margin-bottom: 0;
  }
  .home-release,
  .join {
    margin-top: 3rem;
  }
</style>
