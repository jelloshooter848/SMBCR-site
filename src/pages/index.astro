---
import Base from '../layouts/Base.astro';
import PixelArt from '../components/PixelArt.astro';
import LatestRelease from '../components/LatestRelease.astro';
import HomeChapter1 from '../campaign/HomeChapter1.astro';
import { GAME, SHOW_CAMPAIGN } from '../config';
import { url, media } from '../lib';

// Version 0.5.0 is Classic mode: a true remake of Super Mario Bros. Crossover 3.1.21. The story
// campaign's home page waits in src/campaign for the 1.0 release.

---

{
  SHOW_CAMPAIGN ? (
    <HomeChapter1 />
  ) : (
    <Base>
      <div class="sky home-hero">
        <PixelArt name="cloud" scale={5} class="cloud c1" />
        <PixelArt name="cloud" scale={3} class="cloud c2" />
        <div class="wrap home-hero__inner">
          <h1 class="logo">
            <img
              src={media('logo-remix.png')}
              alt="Super Mario Bros. Crossover: REMIX"
              width="470"
              height="180"
              fetchpriority="high"
            />
          </h1>
          <p class="home-hero__pitch">
            A true remake of <cite>Super Mario Bros. Crossover</cite>: play Super Mario Bros. as the heroes of other NES
            classics, right in your browser. Free, no install, no account.
          </p>
          <div class="btn-row">
            <a class="btn btn--red btn--play" href={GAME.playUrl}>
              ▶ Play
            </a>
            <a class="btn" href={url('how-to-play/')}>
              How to play
            </a>
          </div>
        </div>
        <div class="ground" aria-hidden="true" />
      </div>

      <div class="wrap">
        <p class="notice status">
          <strong>Version {GAME.launchVersion}, the first full release, is on its way.</strong> Until then, test builds
          come out as the work lands, so things may change between visits. Found something odd?{' '}
          <a href={url('community/#bugs')}>Report it</a>.
        </p>

        <section aria-labelledby="pitch-title">
          <h2 id="pitch-title">A fan remake of a fan classic</h2>
          <p class="lede">
            In 2010, Jay Pavlina's Flash game <cite>Super Mario Bros. Crossover</cite> let you run through Super Mario
            Bros. as Mega Man, Link, Samus and friends. Flash is gone, so <strong>REMIX</strong> rebuilds it from scratch
            for modern browsers and phones: the same game, with very little changed, drawn and scored anew with original
            NES-style pixel art and chiptune music. (Exploding Rabbit logo © Jay Pavlina / Exploding Rabbit, used as a tribute in Classic mode; will be replaced on request.)
          </p>
        </section>

        <p>
          <a href={url('heroes/')}>Meet the heroes</a>, explore the <a href={url('modes/')}>maps and modes</a>,{' '}
          <a href={url('how-to-play/')}>see how to play</a>, or read <a href={url('about/#version')}>what's in{' '}
          {GAME.launchVersion} and what's next</a>.
        </p>

        <section class="home-release">
          <LatestRelease />
        </section>

        <section aria-labelledby="join-title" class="panel join">
          <h2 id="join-title">Join in</h2>
          <p>
            Talk about the game and ask questions on the forum. Found a bug? Report it with the bug form and it goes
            straight to the developer.
          </p>
          <div class="btn-row">
            <a class="btn btn--blue" href={url('community/')}>
              Community
            </a>
            <a class="btn btn--blue" href={url('community/#bugs')}>
              Report a bug
            </a>
          </div>
        </section>
      </div>
    </Base>
  )
}

<style>
  .home-hero .c1 {
    top: 24px;
    left: 4%;
  }
  .home-hero .c2 {
    top: 120px;
    right: 12%;
  }
  .home-hero__inner {
    position: relative;
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .logo {
    margin: 0 0 1rem;
    text-shadow: none;
  }
  .logo img {
    width: 100%;
    max-width: 470px;
  }
  .home-hero__pitch {
    font-size: 1.25rem;
    font-weight: 700;
    max-width: 36rem;
  }
  .status {
    margin-top: 2.5rem;
  }
  .home-release,
  .join {
    margin-top: 3rem;
  }
</style>
