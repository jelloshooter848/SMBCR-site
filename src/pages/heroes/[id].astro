---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import Sprite from '../../components/Sprite.astro';
import { CLASSIC_HEROES, clipLevelName, lookSprites, shown, type ClassicHero } from '../../data/classic';
import { media, url } from '../../lib';

export function getStaticPaths() {
  return CLASSIC_HEROES.map((hero) => ({ params: { id: hero.id }, props: { hero } }));
}

interface Props {
  hero: ClassicHero;
}
const { hero } = Astro.props;
const i = CLASSIC_HEROES.indexOf(hero);
const prev = CLASSIC_HEROES[(i - 1 + CLASSIC_HEROES.length) % CLASSIC_HEROES.length] as ClassicHero;
const next = CLASSIC_HEROES[(i + 1) % CLASSIC_HEROES.length] as ClassicHero;
const looks = shown(hero.looks);
const notes = shown(hero.notes ?? []);
---

<Base title={hero.name} description={`${hero.name} in Super Mario Bros. Crossover: REMIX Classic mode: ${hero.tagline.toLowerCase()}. Moves, power-ups and looks.`}>
  <PageBanner title={hero.name} intro={`${hero.tagline}.`} />
  <div class="wrap">
    <figure class="clip">
      <video width="512" height="480" muted loop playsinline controls preload="none" poster={media(`classic/hero-${hero.id}.png`)}>
        <source src={media(`classic/hero-${hero.id}.webm`)} type="video/webm" />
        <source src={media(`classic/hero-${hero.id}.mp4`)} type="video/mp4" />
      </video>
      <figcaption>{hero.name} playing {clipLevelName(hero)}.</figcaption>
    </figure>

    <section aria-labelledby="guide">
      <h2 id="guide">How {hero.name} plays</h2>
      <dl class="panel guide" style={`--accent: ${hero.color}`}>
        {
          shown(hero.rows).map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="looks">
      <h2 id="looks">{looks.length > 1 ? 'Looks' : 'Look'}</h2>
      {
        looks.length > 1 ? (
          <>
            <p>
              Pick a look in the skin menu, or change it with <strong>Special</strong> straight from the select. Looks with
              a note play differently.
            </p>
            <ul class="looks">
              {looks.map((l) => (
                <li>
                  <span class="looks__art">
                    {lookSprites(hero, l).map((sp) => (
                      <Sprite id={sp.id} scale={2} alt={sp.name === l.name ? '' : sp.name} />
                    ))}
                  </span>
                  <span>
                    <strong>{l.name}</strong>
                    {l.note && <>: {l.note}</>}
                  </span>
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p class="one-look">
            <Sprite id={hero.id} scale={2} />
            <span>{hero.name} has one look.</span>
          </p>
        )
      }
      {
        notes.length > 0 && (
          <ul>
            {notes.map((n) => (
              <li>{n.text}</li>
            ))}
          </ul>
        )
      }
    </section>

    <p>
      Weapons and cheats change some of this: see <a href={url('modes/')}>Maps &amp; modes</a>.
    </p>

    <nav class="pager" aria-label="More heroes">
      <a class="btn btn--blue" href={url(`heroes/${prev.id}/`)}>◀ {prev.name}</a>
      <a class="btn btn--blue" href={url('heroes/')}>All heroes</a>
      <a class="btn btn--blue" href={url(`heroes/${next.id}/`)}>{next.name} ▶</a>
    </nav>
  </div>
</Base>

<style>
  .guide {
    border-color: var(--accent, var(--panel-edge));
    margin-top: 0;
  }
  .guide > div + div {
    margin-top: 1rem;
  }
  .guide dt {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--gold);
  }
  .guide dd {
    margin: 0.35rem 0 0;
  }
  .clip {
    margin: 2rem 0 0;
    max-width: 512px;
  }
  .clip video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--black);
    image-rendering: pixelated;
  }
  .clip figcaption {
    margin-top: 0.4rem;
    color: var(--muted);
    font-size: 0.85rem;
  }
  .looks {
    list-style: none;
    padding: 0;
  }
  .looks li,
  .one-look {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }
  /* Room for the tallest look (34 px at 2x), so the names line up. */
  .looks__art {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 0.25rem;
    flex: none;
    min-width: 5.5rem;
    min-height: 68px;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 3rem;
  }
</style>
