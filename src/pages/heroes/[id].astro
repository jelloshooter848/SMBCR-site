---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { CLASSIC_HEROES, shown, type ClassicHero } from '../../data/classic';
import { url } from '../../lib';

export function getStaticPaths() {
  return CLASSIC_HEROES.map((hero) => ({ params: { id: hero.id }, props: { hero } }));
}

interface Props {
  hero: ClassicHero;
}
const { hero } = Astro.props;
const i = CLASSIC_HEROES.indexOf(hero);
const prev = CLASSIC_HEROES[(i - 1 + CLASSIC_HEROES.length) % CLASSIC_HEROES.length] as ClassicHero;
const next = CLASSIC_HEROES[(i + 1) % CLASSIC_HEROES.length] as ClassicHero;
const looks = shown(hero.looks);
const notes = shown(hero.notes ?? []);
---

<Base title={hero.name} description={`${hero.name} in Super Mario Bros. Crossover: REMIX Classic mode: ${hero.tagline.toLowerCase()}. Moves, power-ups and looks.`}>
  <PageBanner title={hero.name} intro={`${hero.tagline}.`} />
  <div class="wrap">
    <section aria-labelledby="guide">
      <h2 id="guide">How {hero.name} plays</h2>
      <dl class="panel guide" style={`--accent: ${hero.color}`}>
        {
          shown(hero.rows).map((r) => (
            <div>
              <dt>{r.label}</dt>
              <dd>{r.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="looks">
      <h2 id="looks">{looks.length > 1 ? 'Looks' : 'Look'}</h2>
      {
        looks.length > 1 ? (
          <>
            <p>
              Pick a look in the skin menu, or change it with <strong>Special</strong> straight from the select. Looks with
              a note play differently.
            </p>
            <ul class="looks">
              {looks.map((l) => (
                <li>
                  <strong>{l.name}</strong>
                  {l.note && <>: {l.note}</>}
                </li>
              ))}
            </ul>
          </>
        ) : (
          <p>{hero.name} has one look.</p>
        )
      }
      {
        notes.length > 0 && (
          <ul>
            {notes.map((n) => (
              <li>{n.text}</li>
            ))}
          </ul>
        )
      }
    </section>

    <p>
      Weapons, cheats and More settings change some of this: see <a href={url('modes/')}>Maps &amp; modes</a>.
    </p>

    <nav class="pager" aria-label="More heroes">
      <a class="btn btn--blue" href={url(`heroes/${prev.id}/`)}>◀ {prev.name}</a>
      <a class="btn btn--blue" href={url('heroes/')}>All heroes</a>
      <a class="btn btn--blue" href={url(`heroes/${next.id}/`)}>{next.name} ▶</a>
    </nav>
  </div>
</Base>

<style>
  .guide {
    border-color: var(--accent, var(--panel-edge));
    margin-top: 0;
  }
  .guide > div + div {
    margin-top: 1rem;
  }
  .guide dt {
    font-family: var(--font-pixel);
    font-size: 0.65rem;
    color: var(--gold);
  }
  .guide dd {
    margin: 0.35rem 0 0;
  }
  .looks li {
    margin-bottom: 0.5rem;
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: space-between;
    margin-top: 3rem;
  }
</style>
