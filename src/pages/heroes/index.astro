---
import Base from '../../layouts/Base.astro';
import PageBanner from '../../components/PageBanner.astro';
import { CLASSIC_HEROES, HERO_RULES, RANDOM, shown } from '../../data/classic';
import { url } from '../../lib';

const lookCount = (id: string) => shown(CLASSIC_HEROES.find((h) => h.id === id)?.looks ?? []).length;
---

<Base title="Heroes" description="The heroes of Super Mario Bros. Crossover: REMIX Classic mode: their moves, power-ups and looks.">
  <PageBanner
    title="Heroes"
    intro="The original's ten heroes and a Random pick, each playing Super Mario Bros. with the moves of their own game."
  />
  <div class="wrap">
    <section aria-labelledby="select-title">
      <h2 id="select-title">The hero select</h2>
      <p>Five heroes on the top row and six on the bottom, laid out as in the original.</p>
      <ul class="rules">
        {shown(HERO_RULES).map((r) => <li>{r.text}</li>)}
      </ul>
    </section>

    <section aria-labelledby="roster-title">
      <h2 id="roster-title">The heroes</h2>
      <ul class="grid roster">
        {
          CLASSIC_HEROES.map((h) => (
            <li class="panel card" style={`--accent: ${h.color}`}>
              <h3>
                <a href={url(`heroes/${h.id}/`)}>{h.name}</a>
              </h3>
              <p>{h.tagline}.</p>
              {lookCount(h.id) > 1 && <p class="meta">{lookCount(h.id)} looks</p>}
            </li>
          ))
        }
        <li class="panel card">
          <h3>Random</h3>
          {shown(RANDOM).map((r) => <p>{r.text}</p>)}
        </li>
      </ul>
    </section>

  </div>
</Base>

<style>
  .rules li {
    margin-bottom: 0.5rem;
  }
  .roster {
    list-style: none;
    padding: 0;
  }
  .roster .card {
    border-color: var(--accent, var(--panel-edge));
  }
  .roster h3 {
    margin: 0 0 0.5rem;
  }
  .roster h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .roster h3 a:hover {
    color: var(--gold);
  }
  .roster p {
    margin: 0 0 0.5rem;
  }
  .meta {
    color: var(--muted);
  }
</style>
