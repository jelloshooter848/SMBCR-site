---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Sprite from '../components/Sprite.astro';
import { CLASSIC_HEROES, MAP_SETS, DIFFICULTY, GAME_MODES, WEAPONS, CHEATS, shown } from '../data/classic';
import { media, url } from '../lib';

const DIFFICULTIES = [
  { id: 'easy', name: 'Easy' },
  { id: 'normal', name: 'Normal' },
  { id: 'hard', name: 'Hard' },
];
const heroName = (id: string) => CLASSIC_HEROES.find((h) => h.id === id)?.name ?? id;
---

<Base title="Maps & modes" description="The map sets, difficulties, game modes, weapons and cheats of Super Mario Bros. Crossover: REMIX Classic mode.">
  <PageBanner title="Maps & modes" intro="Pick Classic on the title screen, then a map set and one of its save files." />
  <div class="wrap page">
    <section aria-labelledby="sets">
      <h2 id="sets">Map sets</h2>
      <p>
        Each map set has three save files. A new file asks its difficulty and its rules (game mode, weapons, More
        settings and which heroes are on), and keeps them for good; a used file carries on where you left it.
      </p>
      <div class="grid">
        {
          shown(MAP_SETS).map((m) => (
            <div class="panel">
              <h3>{m.name}</h3>
              <p>{m.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="difficulty">
      <h2 id="difficulty">Easy, Normal or Hard</h2>
      {DIFFICULTY.map((d) => <p>{d.text}</p>)}
      <p>The same run through the start of World 1-1 at each difficulty:</p>
      <div class="difficulties">
        {
          DIFFICULTIES.map((d) => (
            <figure class="panel">
              <video
                width="512"
                height="480"
                muted
                loop
                playsinline
                controls
                preload="metadata"
                poster={media(`classic/difficulty-${d.id}.png`)}
                data-difficulty-clip
              >
                <source src={media(`classic/difficulty-${d.id}.webm`)} type="video/webm" />
                <source src={media(`classic/difficulty-${d.id}.mp4`)} type="video/mp4" />
              </video>
              <figcaption>{d.name}</figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="modes">
      <h2 id="modes">Game modes</h2>
      <dl class="defs">
        {
          GAME_MODES.map((m) => (
            <div>
              <dt>{m.name}</dt>
              <dd>{m.text}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    <section aria-labelledby="weapons">
      <h2 id="weapons">Weapons</h2>
      <p>Each hero's weapons. Pick one in a new save file's <strong>Weapons</strong>; the first is the original's.</p>
      <ul class="grid weapons">
        {
          WEAPONS.map((w) => (
            <li class="panel">
              <div class="weapons__hero">
                <Sprite id={w.hero} scale={2} />
                <h3>{heroName(w.hero)}</h3>
              </div>
              <ul class="chips">
                {w.weapons.map((name) => (
                  <li>{name}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="cheats">
      <h2 id="cheats">Cheats</h2>
      <p>
        The original's cheats, in <strong>Options → Cheats</strong>, all off by default. A locked cheat shows as{' '}
        <strong>?????</strong>: select it to see its goal.
      </p>
      <div class="table-wrap panel">
        <table>
          <caption class="visually-hidden">Cheats, what they do and how to unlock them</caption>
          <thead>
            <tr><th scope="col">Cheat</th><th scope="col">What it does</th><th scope="col">How to unlock it</th></tr>
          </thead>
          <tbody>
            {
              shown(CHEATS).map((c) => (
                <tr>
                  <td>{c.name}</td>
                  <td>{c.does}</td>
                  <td>{c.unlock}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p>
        Beat a map set and its file stays <strong>CLEARED</strong>: pick it to replay any level of that set with the
        file's rules and unlimited lives. Beat it on Hard and that file also unlocks <strong>Advanced cheats</strong> for its
        replays: no damage, a safety floor, show hidden items, slow motion and more. A run from a shared level link (such
        as <code>?level=sp-1-1</code>) counts toward the cheats' goals too.
      </p>
    </section>

    <p>
      More on the heroes: <a href={url('heroes/')}>Heroes</a>. Controls and accessibility:{' '}
      <a href={url('how-to-play/')}>How to play</a>.
    </p>
  </div>
</Base>

<style>
  .page section {
    margin-top: 2.5rem;
  }
  .page h3 {
    margin-top: 0;
    color: var(--gold);
  }
  .difficulties {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .difficulties figure {
    margin: 0;
    padding: 0.75rem;
  }
  .difficulties video {
    display: block;
    width: 100%;
    height: auto;
    background: var(--black);
    image-rendering: pixelated;
  }
  .difficulties figcaption {
    font-family: var(--font-pixel);
    font-size: 0.8rem;
    color: var(--gold);
    text-align: center;
    margin-top: 0.6rem;
  }
  .defs > div + div {
    margin-top: 0.85rem;
  }
  .defs dt {
    font-weight: 700;
  }
  .defs dd {
    margin: 0.2rem 0 0;
  }
  .weapons {
    list-style: none;
    padding: 0;
  }
  .weapons__hero {
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    min-height: 68px;
  }
  .weapons__hero h3 {
    margin: 0;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 0.85rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .chips li {
    padding: 0.15rem 0.5rem;
    border: 2px solid var(--panel-edge);
    font-size: 0.9rem;
  }
  .chips li:first-child {
    border-color: var(--gold);
  }
</style>

<script>
  // The three difficulty clips play together, so they stay in step (not under reduced motion).
  const clips = [...document.querySelectorAll<HTMLVideoElement>('[data-difficulty-clip]')];
  if (clips.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const start = () => {
      for (const v of clips) {
        v.currentTime = 0;
        void v.play().catch(() => {});
      }
    };
    const box = clips[0]?.closest('.difficulties');
    // Start them when they come into view, so all three begin at the start of the run.
    if (box && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          start();
        }
      });
      io.observe(box);
    } else start();
  }
</script>
