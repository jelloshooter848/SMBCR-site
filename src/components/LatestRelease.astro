---
import { GAME } from '../config';
import { url } from '../lib';

interface Props {
  headingLevel?: 2 | 3;
}
const { headingLevel = 2 } = Astro.props;
const H = `h${headingLevel}`;
---

<section
  class="panel panel--gold release"
  data-latest-release
  data-api={GAME.releasesApi}
  data-first={`v${GAME.launchVersion}`}
  aria-labelledby="latest-release-title"
>
  <H id="latest-release-title">Latest release</H>
  <p class="release__line">
    <strong data-r="version">v{GAME.launchVersion}</strong>
    <span data-r="date"></span>
  </p>
  <p data-r="test" hidden>
    This is a <strong>test build</strong> on the way to version {GAME.launchVersion}, the first full release. Things may
    change or break: <a href={url('community/#bugs')}>report what you find</a>.
  </p>
  <p>
    Play online any time, or take it with you: the <strong>offline zip</strong> opens straight from its folder, with no
    install. <a href={url('versions/#offline')}>About the downloads</a>.
  </p>
  <div class="btn-row">
    <a class="btn btn--red" href={GAME.playUrl}>▶ Play now</a>
    <a class="btn" data-r="download" href={GAME.latestReleaseUrl}>Download zip</a>
    <a class="btn btn--blue" data-r="offline" href={GAME.latestReleaseUrl} hidden>Offline zip</a>
    <a data-r="notes" href={url('news/')}>What's new</a>
  </div>
  <p class="meta" data-r="status" aria-live="polite"></p>
</section>

<style>
  .release__line {
    font-size: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
  }
  .meta {
    color: var(--muted);
    font-size: 0.95rem;
    margin: 0;
  }
  .meta:empty {
    display: none;
  }
</style>

<script>
  import { latestRelease, zipAsset, offlineZipAsset, isBefore, formatSize, formatDate } from '../scripts/releases';

  for (const box of document.querySelectorAll<HTMLElement>('[data-latest-release]')) {
    const $ = (k: string) => box.querySelector<HTMLElement>(`[data-r="${k}"]`);
    latestRelease(box.dataset.api as string)
      .then((r) => {
        const version = $('version');
        if (version) version.textContent = r.name || r.tag_name;
        const date = $('date');
        if (date) date.textContent = `Released ${formatDate(r.published_at)}`;
        const test = $('test');
        if (test) test.hidden = !(r.prerelease || isBefore(r.tag_name, box.dataset.first as string));
        // The offline zip is the download for players; the other one is the website, for hosting.
        const offline = offlineZipAsset(r);
        const off = $('offline') as HTMLAnchorElement | null;
        if (off && offline) {
          off.href = offline.browser_download_url;
          off.textContent = `Download ${offline.name} (${formatSize(offline.size)})`;
          off.setAttribute('download', '');
          off.hidden = false;
          off.className = 'btn';
          const site = $('download');
          if (site) site.className = 'btn btn--blue';
        }
        const zip = zipAsset(r);
        const dl = $('download') as HTMLAnchorElement | null;
        if (dl && zip) {
          dl.href = zip.browser_download_url;
          dl.textContent = `Download ${zip.name} (${formatSize(zip.size)})`;
          dl.setAttribute('download', '');
        }
        const notes = $('notes') as HTMLAnchorElement | null;
        if (notes) {
          notes.href = r.html_url;
          notes.textContent = `${r.tag_name} release notes`;
        }
      })
      .catch(() => {
        const s = $('status');
        if (s) s.textContent = "Couldn't reach GitHub just now. The download button opens the releases page instead.";
      });
  }
</script>
