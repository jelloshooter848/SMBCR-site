---
import { SPRITES, type SpriteName } from '../data/sprites';

interface Props {
  name: SpriteName;
  /** Pixel size in CSS px. */
  scale?: number;
  /** An accessible name; without one the sprite is decorative and hidden from screen readers. */
  label?: string;
  class?: string;
}
const { name, scale = 3, label, class: cls } = Astro.props;
const sprite = SPRITES[name];
const h = sprite.rows.length;
const w = Math.max(...sprite.rows.map((r) => r.length));
// One rect per run of same-coloured pixels in a row.
const rects: { x: number; y: number; w: number; fill: string }[] = [];
sprite.rows.forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const c = row[x];
    let end = x + 1;
    while (end < row.length && row[end] === c) end++;
    const fill = (sprite.palette as Record<string, string>)[c];
    if (c !== '.' && fill) rects.push({ x, y, w: end - x, fill });
    x = end;
  }
});
---

<svg
  class:list={['pixel-art', cls]}
  width={w * scale}
  height={h * scale}
  viewBox={`0 0 ${w} ${h}`}
  shape-rendering="crispEdges"
  {...label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' }}
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
